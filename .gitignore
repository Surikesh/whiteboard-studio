# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/.vinext/
/out/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
next-env.d.ts
/dist/
/.wrangler/
/.share-tunnel/
/backups/
/outputs/
/work/

# macOS shell build output
/macos/TldrawLab/.build/

# build/type-check artifacts
*.tsbuildinfo

# local agent loop state
.pi/

# Checkout-local runtime data. The default data dir is ~/TldrawLab-data (outside the
# checkout); if you point TLDRAW_LAB_DATA_DIR inside the checkout, use ./data or
# ./TldrawLab-data. These hold config.json (may contain credentials), state/, boards/,
# revisions/, assets/ and bridge/ (chat history). Shipped demos live in public/ and are not ignored.
/data/
/TldrawLab-data/
/.tldraw-lab-logs/
